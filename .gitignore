# ── Data (heavy) ──────────────────────────────
/data/
*.csv
*.npy
*.npz
*.pt
*.pth
*.pkl
*.json
# Allow sensing-matrix snapshots (needed to reload checkpoints on CPU)
!results/checkpoints/A_*.npy
# Allow notebook 04/05 summary tables and configs (tiny; keeps every archived
# dataset x ratio cell reproducible from a fresh clone)
!results/notebook_04/**/tables/*.csv
!results/notebook_04/**/config.json
!results/notebook_05/**/tables/*.csv
!results/notebook_05/**/config.json

# ── Python ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/

# ── Jupyter ──────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── virtual Environments ─────────────────────────────────────
venv/
.venv/
env/
.env

